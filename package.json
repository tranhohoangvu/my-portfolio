{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Tran Ho Hoang Vu — static site built with HTML, Tailwind CSS v4 and vanilla JavaScript.",
  "scripts": {
    "build:css": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --minify",
